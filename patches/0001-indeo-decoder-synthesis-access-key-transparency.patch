+                     0x10000U - 3*kd + (kr >> 1) - 3*k + (krd >> 1);
+                p0 = ivi_scalar_clip(p0, 1);
+                p1 = ivi_scalar_clip(p1, 0);
+                p2 = ivi_scalar_clip(p2, 0);
+                p3 = ivi_scalar_clip(p3, 0);
