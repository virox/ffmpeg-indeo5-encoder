+/* Intel's scalar filter packs columns eight band samples apart into a
+ * uint32_t. Its additions and shifts intentionally carry between the lanes;
+ * evaluating the same filter as independent signed samples loses those rare
+ * rounding effects. Recreate its biased 4x coefficient representation and
+ * operation order, with defined unsigned wraparound (FUN_10032bf8). */
+static uint32_t ivi_scalar_pair(const int16_t *row, int x0, int x1)
+{
+    return ((row[x0] * 4 + 0x4000) & 0xffff) |
+           (uint32_t)((row[x1] * 4 + 0x4000) & 0xffff) << 16;
+}
+
+static uint32_t ivi_scalar_clip(uint32_t value, int ll_pixel)
+{
+    uint32_t mask = ll_pixel ? (value >> 10) & 0xfff00030U :
+                               (value & 0xc000c000U) >> 10;
+    uint32_t result;
+
+    mask += 0x3ff03ff0U;
+    result = value & mask;
+    mask = (mask | 0x7fc07fc0U) - 0x3fd03fd0U;
+    return (result | mask) >> 6;
+}
+
+static void ivi_recompose53_scalar(const IVIPlaneDesc *plane, uint8_t *dst,
+                                  ptrdiff_t dst_pitch)
+{
+    const int width = FFALIGN(plane->width, 32) / 2;
+    const int height = (plane->height + 1) / 2;
+    const ptrdiff_t pitch = plane->bands[0].pitch;
+    const uint32_t bias = 0x1fff2000U;
+    int y, group, i, lane;
+
+    for (y = 0; y < height; y++) {
+        int below = FFMIN(y + 1, height - 1);
+        int above = FFMAX(y - 1, 0);
+        int high_below = y + 1 < height ? y + 1 : above;
+        const int16_t *ll = plane->bands[0].buf + y * pitch;
+        const int16_t *lld = plane->bands[0].buf + below * pitch;
+        const int16_t *hl = plane->bands[1].buf + y * pitch;
+        const int16_t *hlu = plane->bands[1].buf + above * pitch;
+        const int16_t *hld = plane->bands[1].buf + high_below * pitch;
+        const int16_t *lh = plane->bands[2].buf + y * pitch;
+        const int16_t *lhd = plane->bands[2].buf + below * pitch;
+
+        for (group = 0; group < width; group += 16) {
+            for (i = 0; i < 8; i++) {
+                int x0 = group + i, x1 = x0 + 8;
+                int l0 = FFMAX(x0 - 1, 0), l1 = x1 - 1;
+                int r0 = x0 + 1, r1 = FFMIN(x1 + 1, width - 1);
+                uint32_t a = ivi_scalar_pair(ll, x0, x1);
+                uint32_t b = ivi_scalar_pair(ll, r0, r1);
+                uint32_t c = ivi_scalar_pair(lld, x0, x1);
+                uint32_t d = ivi_scalar_pair(lld, r0, r1);
+                uint32_t hu = ivi_scalar_pair(hlu, x0, x1);
+                uint32_t h = ivi_scalar_pair(hl, x0, x1);
+                uint32_t hd = ivi_scalar_pair(hld, x0, x1);
+                uint32_t hur = ivi_scalar_pair(hlu, r0, r1);
+                uint32_t hr = ivi_scalar_pair(hl, r0, r1);
+                uint32_t hdr = ivi_scalar_pair(hld, r0, r1);
+                uint32_t kl = ivi_scalar_pair(lh, l0, l1);
+                uint32_t k = ivi_scalar_pair(lh, x0, x1);
+                uint32_t kr = ivi_scalar_pair(lh, r0, r1);
+                uint32_t kld = ivi_scalar_pair(lhd, l0, l1);
+                uint32_t kd = ivi_scalar_pair(lhd, x0, x1);
+                uint32_t krd = ivi_scalar_pair(lhd, r0, r1);
+                uint32_t p0, p1, p2, p3;
+
+                p0 = bias + 4*a + 2*(hu+h) - 0x10000U +
+                     2*(kl+k) - 0x10000U;
+                p1 = bias + 2*a + 2*b + hu+h+hr+hur - 0x10000U +
+                     kl + 2*((kr >> 1) - 3*k) + 0x10000U;
+                p2 = bias + 2*a + 2*c + 2*((hu+hd) >> 1) + 0x10000U -
+                     6*h + 2*((kl+kld) >> 1) + k+kd + 0x10000U;
+                /* The final pair in each group uses the lane-crossing loop,
+                 * whose horizontal sum carries a different guard bias. */
+                if (i == 7)
+                    p2 -= 0x20000U;
