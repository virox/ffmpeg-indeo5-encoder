+/*
+ * Intel's decoder (IR50_32.DLL FUN_1003eaf0, FUN_10034040) synthesises a
+ * scalable luma plane with transparency only inside the bounding box of the
+ * transparency rectangles: rows from the even row at or above its top,
+ * columns widened to multiples of 32, and the box borders are treated like
+ * picture edges. Redo that region so that the opaque pixels match.
+ */
+static int recompose_transp_rect(IVI45DecContext *ctx, uint8_t *dst, ptrdiff_t dst_pitch)
+{
+    const IVIPlaneDesc *plane = &ctx->planes[0];
+    IVIPlaneDesc sub = *plane;
+    IVIBandDesc bands[4];
+    int x = ctx->transp_rect[0], y = ctx->transp_rect[1];
+    int x1 = FFMIN(x + ctx->transp_rect[2], plane->width);
+    int y1 = FFMIN(y + ctx->transp_rect[3], plane->height);
+    int c0, c1, r0, w, h;
+    uint8_t *tmp;
+
+    if (x >= x1 || y >= y1)
+        return 0;
+    r0 = y & ~1;
+    c0 = x & ~31;
+    c1 = FFALIGN(x1, 32);
+    w  = c1 - c0;
+    h  = y1 - r0;
+    if (c1 / 2 > plane->bands[0].pitch)
+        return 0;
+    tmp = av_malloc(w * (h + 1));
+    if (!tmp)
+        return AVERROR(ENOMEM);
+    sub.width  = w;
+    sub.height = h;
+    sub.bands  = bands;
+    for (int b = 0; b < 4; b++) {
+        bands[b]     = plane->bands[b];
+        bands[b].buf = plane->bands[b].buf + (r0 >> 1) * plane->bands[b].pitch + (c0 >> 1);
+        /* Synthesis bounds are relative to the shifted band origin. */
+    }
+    ff_ivi_recompose53(&sub, tmp, w, ctx->scalar_synthesis ? 3 : 4);
+    for (int j = 0; j < h; j++)
+        memcpy(dst + (r0 + j) * dst_pitch + c0, tmp + j * w, FFMIN(c1, plane->width) - c0);
+    av_free(tmp);
+    return 0;
